      {
       "_type": "UMLNoteView",
       "_id": "SSW003990",
       "_parent": {
        "$ref": "SSW003542"
       },
       "font": "Arial;13;0",
       "left": 40,
       "top": 20,
       "width": 1100,
       "height": 100,
       "text": "Observer: Publicacion y Contratacion publican eventos; el registrador de historial y el notificador reaccionan sin que el dominio los conozca. El notificador pide a la Simple Factory el Adapter del canal preferido de cada destinatario (email/push/interna). Adapter tambien para la identidad externa."
      }
