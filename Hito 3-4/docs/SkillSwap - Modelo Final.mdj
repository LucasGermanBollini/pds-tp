      {
       "_type": "UMLNoteView",
       "_id": "SSW003251",
       "_parent": {
        "$ref": "SSW002852"
       },
       "font": "Arial;13;0",
       "left": 40,
       "top": 20,
       "width": 1100,
       "height": 100,
       "text": "State: el Context (Publicacion/Contratacion) delega cada accion en su estado actual. La clase Base rechaza todo por defecto (IllegalStateException) y cada estado concreto habilita solo sus transiciones (tablas 4.2 y 4.5). En la base se guarda el nombre del estado y la Simple Factory reconstruye el objeto en @PostLoad."
      }
     ],
     "defaultDiagram": false
